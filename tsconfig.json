{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@windy/*": [
        "./node_modules/@windycom/plugin-devtools/types/*",
        "./node_modules/@windycom/plugin-devtools/types/client/*"
      ]
    }
  },
  "include": ["src/pluginConfig.ts"]
}
